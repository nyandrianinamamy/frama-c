MACRO: EVA_PLUGINS eva,from,inout,scope,callgraph
MACRO: EVA_TEST -eva @EVA_OPTIONS@ -out -input -deps

# Compare the result with the oracle of the default config.
FILTER: diff --new-file %{dep:@PTEST_SUITE_DIR@/result/@PTEST_RESULT@} -

PLUGIN: @EVA_PLUGINS@
OPT: @EVA_TEST@

# Late declaration to allow redefinition of EVA_OPTIONS in subsidiary test_config_xxx files
MACRO: EVA_OPTIONS -machdep x86_32 -eva-msg-key=progress,-summary -eva-domains multidim -eva-warn-key experimental=inactive
