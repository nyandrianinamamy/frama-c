Test [getDeadCode] request on file stats.i.
  $ frama-c -test dead_code
  [test] Request SET kernel.ast.setFiles [ stats.i ];
  [kernel] Parsing stats.i (no preprocessing)
  [test] Request EXEC plugins.eva.analysis.compute;
  [test] Request GET plugins.eva.ast.getDeadCode function reachable:
      { unreachable: [], reached: [ return; ], nonTerminating: [] }
  [test] Request GET plugins.eva.ast.getDeadCode function unreachable:
      { unreachable: [ return; ], reached: [], nonTerminating: [] }
  [test] Request GET plugins.eva.ast.getDeadCode function coverage:
      { unreachable: [ unreachable(); ],
        reached: [ return;,
                   non_terminating();,
                   if (nondet) non_terminating();,
                   if (x > 10) unreachable();,
                   reachable();,
                   int x = 5; ],
        nonTerminating: [ non_terminating(); ] }

