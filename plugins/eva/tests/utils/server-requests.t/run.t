Print values of variable [x] at each statement of function "values_by_stmt"
in "values.i" file.
  $ frama-c -test values_by_stmt
  [test] Request SET kernel.ast.setFiles [ values.i ];
  [kernel] Parsing values.i (no preprocessing)
  [test] Request EXEC plugins.eva.analysis.compute;
  [test] ----- At statement int x = (int)(nondet % (unsigned int)100); -----
  [test] Request GET plugins.eva.values.getProbeInfo int x = (int)(nondet % (unsigned int)100);:
      { stmt: int x = (int)(nondet % (unsigned int)100);,
        evaluable: true,
        effects: true,
        condition: false,
        code: x }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: UNINITIALIZED, pointedVars: [], alarms: [] },
        vAfter: { value: [0..99], pointedVars: [], alarms: [] } }
  [test] ----- At statement x ++; -----
  [test] Request GET plugins.eva.values.getProbeInfo x ++;:
      { stmt: x ++;, evaluable: true, effects: true, condition: false, code: x }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: [0..99], pointedVars: [], alarms: [] },
        vAfter: { value: [1..100], pointedVars: [], alarms: [] } }
  [test] ----- At statement if (x < 10) x = 10; -----
  [test] Request GET plugins.eva.values.getProbeInfo if (x < 10) x = 10;:
      { stmt: if (x < 10) x = 10;,
        evaluable: true,
        effects: false,
        condition: true,
        code: x < 10 }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vThen: { value: [1..9], pointedVars: [], alarms: [] },
        vElse: { value: [10..100], pointedVars: [], alarms: [] },
        vBefore: { value: [1..100], pointedVars: [], alarms: [] } }
  [test] ----- At statement x = 10; -----
  [test] Request GET plugins.eva.values.getProbeInfo x = 10;:
      { stmt: x = 10;,
        evaluable: true,
        effects: true,
        condition: false,
        code: x }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: [1..9], pointedVars: [], alarms: [] },
        vAfter: { value: {10}, pointedVars: [], alarms: [] } }
  [test] ----- At statement if (x < 0) unreachable(); -----
  [test] Request GET plugins.eva.values.getProbeInfo if (x < 0) unreachable();:
      { stmt: if (x < 0) unreachable();,
        evaluable: true,
        effects: false,
        condition: true,
        code: x < 0 }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vThen: { value: Unreachable, pointedVars: [], alarms: [] },
        vElse: { value: [10..100], pointedVars: [], alarms: [] },
        vBefore: { value: [10..100], pointedVars: [], alarms: [] } }
  [test] ----- At statement unreachable(); -----
  [test] Request GET plugins.eva.values.getProbeInfo unreachable();:
      { evaluable: false, effects: false, condition: false }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: Unreachable, pointedVars: [], alarms: [] } }
  [test] ----- At statement /*@ assert x > 20; */ ; -----
  [test] Request GET plugins.eva.values.getProbeInfo ;:
      { evaluable: false, effects: false, condition: false }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: [10..100], pointedVars: [], alarms: [] },
        vAfter: { value: [21..100], pointedVars: [], alarms: [] } }
  [test] ----- At statement return; -----
  [test] Request GET plugins.eva.values.getProbeInfo return;:
      { evaluable: false, effects: false, condition: false }
  [test] Request GET plugins.eva.values.getValues { target: x }:
      { vBefore: { value: [21..100], pointedVars: [], alarms: [] } }

