@@ -0,0 +1,125 @@
+open Cil_types
+
+type frame =
+  { mutable covered : float;
+    mutable covered_ordinary : float }
+
+type dispatch_frame =
+  { function_name : string;
+    mutable children_cpu : float }
+
+type function_stats =
+  { mutable calls : int;
+    mutable affected : int;
+    mutable body_cpu : float;
+    mutable affected_body_cpu : float }
+
+let dispatches = ref []
+let functions = Hashtbl.create 101
+
+let path = Sys.getenv_opt "EVA_WAYFINDER_HEAP_LOG"
+let enabled = Option.is_some path
+let heap_created = ref 0
+let other_created = ref 0
+let stack = ref []
+let all_covered = ref 0.
+let ordinary_covered = ref 0.
+let analysed = ref 0
+let init_analysed = ref 0
+let refused = ref 0
+let heap_refused = ref 0
+let init_heap_refused = ref 0
+let other_refused = ref 0
+let init_clock = ref 0.
+
+let begin_analysis () =
+  if enabled then init_clock := Sys.time ()
+
+let created region =
+  if enabled then
+    match region with
+    | Base.Malloc -> incr heap_created
+    | Base.VLA | Base.Alloca -> incr other_created
+
+let dispatch kf f =
+  if not enabled then f ()
+  else
+    let frame = { function_name = Kernel_function.get_name kf; children_cpu = 0. } in
+    let parents = !dispatches in
+    let start = Sys.time () in
+    dispatches := frame :: parents;
+    let finally () =
+      dispatches := parents;
+      match parents with
+      | [] -> ()
+      | parent :: _ ->
+        parent.children_cpu <- parent.children_cpu +. max 0. (Sys.time () -. start)
+    in
+    Fun.protect ~finally f
+
+let compute callsite ~is_refused f =
+  if not enabled then f ()
+  else
+    let frame = { covered = 0.; covered_ordinary = 0. } in
+    let before_heap = !heap_created and before_other = !other_created in
+    let start = Sys.time () in
+    let parents = !stack in
+    stack := frame :: parents;
+    let result = Fun.protect f ~finally:(fun () -> stack := parents) in
+    let elapsed = max 0. (Sys.time () -. start) in
+    let initial = callsite = Kglobal in
+    let refusal = is_refused result in
+    let heap = refusal && !heap_created > before_heap in
+    let other = refusal && !other_created > before_other in
+    (match !dispatches with
+     | [] -> assert false
+     | dispatch :: _ ->
+       let exclusive = max 0. (elapsed -. dispatch.children_cpu) in
+       let stat = match Hashtbl.find_opt functions dispatch.function_name with
+         | Some stat -> stat
+         | None ->
+           let stat = { calls = 0; affected = 0; body_cpu = 0.; affected_body_cpu = 0. } in
+           Hashtbl.add functions dispatch.function_name stat;
+           stat
+       in
+       stat.calls <- stat.calls + 1;
+       stat.body_cpu <- stat.body_cpu +. exclusive;
+       if heap then begin
+         stat.affected <- stat.affected + 1;
+         stat.affected_body_cpu <- stat.affected_body_cpu +. exclusive
+       end);
+    incr analysed;
+    if initial then incr init_analysed;
+    if refusal then incr refused;
+    if heap then incr heap_refused;
+    if initial && heap then incr init_heap_refused;
+    if other then incr other_refused;
+    let covered = if heap then elapsed else frame.covered in
+    let ordinary = if heap && not initial then elapsed else frame.covered_ordinary in
+    (match parents with
+     | [] ->
+       all_covered := !all_covered +. covered;
+       ordinary_covered := !ordinary_covered +. ordinary
+     | parent :: _ ->
+       parent.covered <- parent.covered +. covered;
+       parent.covered_ordinary <- parent.covered_ordinary +. ordinary);
+    result
+
+let finish complete =
+  Option.iter
+    (fun file ->
+       let elapsed = max 0. (Sys.time () -. !init_clock) in
+       Out_channel.with_open_text file (fun oc ->
+           Printf.fprintf oc
+             "complete	%b\nbody_analysed	%d\nentry_analysed	%d\nbody_refused	%d\nheap_refused	%d\nentry_heap_refused	%d\nstack_alloc_refused	%d\nheap_created	%d\nstack_alloc_created	%d\nanalysis_cpu_s	%.9f\nheap_body_union_cpu_s	%.9f\nheap_ordinary_union_cpu_s	%.9f\n"
+             complete !analysed !init_analysed !refused !heap_refused
+             !init_heap_refused !other_refused !heap_created !other_created
+             elapsed !all_covered !ordinary_covered);
+       Out_channel.with_open_text (file ^ ".functions.tsv") (fun oc ->
+           output_string oc "function\tanalysed\theap_refused\texclusive_body_cpu_s\theap_refused_exclusive_body_cpu_s\n";
+           Hashtbl.fold (fun name stat rows -> (name, stat) :: rows) functions []
+           |> List.sort (fun (name, _) (name', _) -> String.compare name name')
+           |> List.iter (fun (name, stat) ->
+               Printf.fprintf oc "%s\t%d\t%d\t%.9f\t%.9f\n"
+                 name stat.calls stat.affected stat.body_cpu stat.affected_body_cpu)))
+    path
