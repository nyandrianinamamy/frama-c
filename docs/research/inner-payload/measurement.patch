--- /dev/null
+++ b/plugins/eva/src/utils/wayfinder_entry.ml
@@ -0,0 +1,172 @@
+module Used = Set.Make (struct
+    type t = string * string
+    let compare = Stdlib.compare
+  end)
+
+type status =
+  Property.t * Property.t list * Property_status.emitted_status * bool
+
+type alarm = int * Alarms.t * Property_status.emitted_status option
+
+type measure =
+  | Measured of int * float * float
+  | Missing of string
+
+type frame =
+  { mutable projection : (include_locals:bool -> Base.Hptset.t -> measure) option;
+    mutable reached : (int * int) list;
+    mutable statuses : status list;
+    mutable alarms : alarm list;
+    mutable used : Used.t;
+    mutable children : int list;
+    mutable saved : int option }
+
+let path = Sys.getenv_opt "EVA_WAYFINDER_ENTRY_LOG"
+let enabled = Option.is_some path
+let frames = ref []
+let entries = Hashtbl.create 17
+let output = ref None
+let row_count = ref 0
+
+let measure value =
+  let repetitions = 16 in
+  try
+    let encoded = Marshal.to_bytes value [] in
+    let wall_start = Unix.gettimeofday () in
+    let cpu_start = Sys.time () in
+    for _ = 1 to repetitions do
+      ignore (Sys.opaque_identity (Marshal.from_bytes encoded 0))
+    done;
+    let cpu = max 0. (Sys.time () -. cpu_start) in
+    let wall = max 0. (Unix.gettimeofday () -. wall_start) in
+    let n = float repetitions in
+    Measured (Bytes.length encoded, cpu /. n, wall /. n)
+  with Invalid_argument reason | Failure reason -> Missing reason
+
+let current f =
+  match !frames with [] -> () | head :: _ -> f head
+
+let begin_analysis () =
+  Option.iter (fun path ->
+      let channel = open_out path in
+      output := Some channel;
+      row_count := 0;
+      Hashtbl.clear entries;
+      output_string channel
+        "entry\tfunction\texits\treached\talarms\tstatuses\tchildren\tused\tmandatory_bytes\tmandatory_cpu_s\tmandatory_wall_s\tmandatory_error\tkey_inner_bytes\tkey_inner_cpu_s\tkey_inner_wall_s\tkey_inner_error\tfootprint_inner_bytes\tfootprint_inner_cpu_s\tfootprint_inner_wall_s\tfootprint_inner_error\tused_bytes\tused_cpu_s\tused_wall_s\tused_error\n";
+      flush channel)
+    path
+
+let finish complete =
+  Option.iter (fun channel ->
+      Printf.fprintf channel "complete\t%b\ncount\t%d\n" complete !row_count;
+      close_out channel)
+    !output;
+  output := None
+
+let with_body f =
+  if not enabled then f ()
+  else
+    let frame =
+      { projection = None; reached = []; statuses = []; alarms = [];
+        used = Used.empty; children = []; saved = None }
+    in
+    let old = !frames in
+    frames := frame :: old;
+    let finally () =
+      frames := old;
+      current (fun parent ->
+          parent.used <- Used.union parent.used frame.used;
+          match frame.saved with
+          | Some id -> parent.children <- id :: parent.children
+          | None ->
+            parent.children <- List.rev_append frame.children parent.children;
+            parent.reached <- List.rev_append frame.reached parent.reached;
+            parent.statuses <- List.rev_append frame.statuses parent.statuses;
+            parent.alarms <- List.rev_append frame.alarms parent.alarms)
+    in
+    Fun.protect ~finally f
+
+let note_call kf mode =
+  if enabled then current (fun frame ->
+      frame.used <- Used.add (Kernel_function.get_name kf, mode) frame.used)
+
+let reuse id =
+  if enabled then current (fun frame ->
+      frame.children <- id :: frame.children;
+      match Hashtbl.find_opt entries id with
+      | Some used -> frame.used <- Used.union used frame.used
+      | None -> ())
+
+let observe_status emitter hyps property distinct status =
+  if String.equal (Emitter.get_name emitter) "Eva" then
+    current (fun frame ->
+        frame.statuses <- (property, hyps, status, distinct) :: frame.statuses)
+
+let observe_alarm emitter kinstr status alarm =
+  if String.equal (Emitter.get_name emitter) "Eva" then
+    current (fun frame ->
+        let sid = match kinstr with
+          | Cil_types.Kglobal -> -1
+          | Cil_types.Kstmt stmt -> stmt.sid
+        in
+        frame.alarms <- (sid, alarm, status) :: frame.alarms)
+
+let () =
+  if enabled then begin
+    Property_status.register_measure_emit observe_status;
+    Alarms.register_measure_register observe_alarm
+  end
+
+let capture reached projection =
+  current (fun frame ->
+      frame.reached <- List.rev_append reached frame.reached;
+      frame.projection <- Some projection)
+
+let compare_status (prop, hyps, status, distinct)
+    (prop', hyps', status', distinct') =
+  let c = Property.compare prop prop' in
+  if c <> 0 then c else
+    let c = List.compare Property.compare hyps hyps' in
+    if c <> 0 then c else Stdlib.compare (status, distinct) (status', distinct')
+
+let compare_alarm (sid, alarm, status) (sid', alarm', status') =
+  let c = Int.compare sid sid' in
+  if c <> 0 then c else
+    let c = Alarms.compare alarm alarm' in
+    if c <> 0 then c else Stdlib.compare status status'
+
+let write_measure channel = function
+  | Measured (bytes, cpu, wall) ->
+    Printf.fprintf channel "\t%d\t%.12f\t%.12f\t" bytes cpu wall
+  | Missing reason -> Printf.fprintf channel "\t\t\t\t%S" reason
+
+let record kf id exits key footprint =
+  if enabled then current (fun frame ->
+      let reached = List.sort_uniq Stdlib.compare frame.reached in
+      let statuses = List.sort_uniq compare_status frame.statuses in
+      let alarms = List.sort_uniq compare_alarm frame.alarms in
+      let children = List.sort_uniq Int.compare frame.children in
+      let used = Used.elements frame.used in
+      let project = match frame.projection with
+        | None -> fun ~include_locals:_ _ -> Missing "per-call statement states unavailable"
+        | Some f -> f
+      in
+      let footprint_inner = match footprint with
+        | None -> Missing "read/write footprint is Top or unavailable"
+        | Some footprint -> project ~include_locals:false footprint
+      in
+      frame.saved <- Some id;
+      Hashtbl.replace entries id frame.used;
+      incr row_count;
+      Option.iter (fun channel ->
+          Printf.fprintf channel "%d\t%s\t%d\t%d\t%d\t%d\t%d\t%d"
+            id (Kernel_function.get_name kf) (List.length exits)
+            (List.length reached) (List.length alarms) (List.length statuses)
+            (List.length children) (List.length used);
+          write_measure channel (measure (exits, alarms, statuses, reached, children));
+          write_measure channel (project ~include_locals:true key);
+          write_measure channel footprint_inner;
+          write_measure channel (measure used);
+          output_char channel '\n')
+        !output)
