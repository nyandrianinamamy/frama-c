    "templates":
    {
        "-absolute-valid-range": ["0x0-0xff", "0x1234-0xffff", "0x123456-0x789012"],
        "-aorai-instrumentation-history": {"range": ["0", "999"]},
        "-aorai-output-c-file": ["fuzzed_aorai.c"],
        "-aorai-to-buchi": ["fuzzed_aorai_buchi.promela"],
        "-big-ints-hex": ["0xffff"],
        "-ce-prover": ["alt-ergo-interpreter", "alt-ergo", "cvc4", "simplify", "z3"],
        "-cg": ["fuzzed_cg.dot"],
        "-cg-roots": "functions",
        "-cg-service-roots": "functions",
        "-dot-postdom": ["fuzzed_postdom.dot"],
        "-eva-alloc-functions": "functions",
        "-eva-domains":["cvalue", "symbolic-locations", "equality", "gauges", "octagon", "bitwise", "sign", "inout", "traces", "printer", "apron-octagon", "apron-box", "apron-polka-loose", "apron-polka-strict", "apron-polka-equality", "numerors"],
        "-eva-flamegraph": "output-file",
        "-eva-ilevel": ["4", "8",  "16",  "32",  "64",  "128", "256"],
        "-eva-numerors-log-file": "output-file",
        "-eva-partition-value": "variable",
        "-eva-report-red-statuses": "output-file",
        "-eva-slevel-merge-after-loop": ["@all"],
        "-eva-split-return": ["auto"],
        "-eva-traces-dot": "output-file",
        "-eva-warn-copy-indeterminate":["@all"],
        "-eva-warn-key": {"keys":["eva", "*", "alarm", "builtins", "builtins:missing-spec", "builtins:override", "experimental", "garbled-mix", "invalid-assigns", "libc", "libc:unsupported-spec", "locals-escaping", "loop-unroll", "malloc", "malloc:imprecise", "malloc:weak", "missing-loop-unroll", "missing-loop-unroll:for", "signed-overflow"], "values":["active", "feedback",  "error", "abort", "once", "feedback-once", "err-once", "inactive"]},
        "-fct-pdg": "functions",
        "-impact-pragma": "functions",
        "-inline-calls":["@all"],
        "-machdep":["x86_16", "x86_32", "x86_64", "gcc_x86_16", "gcc_x86_32", "gcc_x86_64", "ppc_32", "msvc_x86_64"],
        "-main": "functions",
        "-mdr-authors":["", "John Doe", "John Doe, Jane, Anne Onimous"],
        "-mdr-date":["", "today", "31/12/2999"],
        "-mdr-stubs": "functions",
        "-mdr-title": ["", "TITLE", ";' DROP TABLES <\""],
        "-metrics-cover": "functions",
        "-metrics-locals-size": "functions",
        "-metrics-output": ["fuzzed_metrics.txt", "fuzzed_metrics.html", "fuzzed_metrics.json"],
        "-mt-keep-analyses": ["all", "last", "none"],
        "-nonterm-ignore": "functions",
        "-pc-com": ["internet", "unix", "stdio"],
        "-pdg-dot": ["fuzzed_pdg.dot"],
        "-remove-inlined": "functions",
        "-report-csv": ["fuzzed_report.csv"],
        "-report-output": ["fuzzed_report.json"],
        "-rte-initialized": "functions",
        "-rte-select": "functions",
        "-scf-fct": "functions",
        "-ulevel": ["-1", "0", "1", "3", "10"],
        "-wp-auto": ["wp:bitrange", "wp:bitshift", "wp:bittestrange", "wp:bitwised", "wp:congruence", "wp:range", "wp:replace", "wp:split"],
        "-wp-auto-backtrack": ["0", "1", "2", "5"],
        "-wp-auto-depth": ["0", "1", "5", "10", "20"],
        "-wp-auto-width": ["0", "1", "5", "10", "20"],
        "<LIST_TERMINATOR>": []
    }
}
