diff --git a/plugins/eva/src/utils/cost_meter.ml b/plugins/eva/src/utils/cost_meter.ml
new file mode 100644
index 0000000000..3a6d14d67b
--- /dev/null
+++ b/plugins/eva/src/utils/cost_meter.ml
@@ -0,0 +1,137 @@
+(**************************************************************************)
+(*                                                                        *)
+(*  SPDX-License-Identifier LGPL-2.1                                      *)
+(*  Copyright (C)                                                         *)
+(*  CEA (Commissariat à l'énergie atomique et aux énergies alternatives)  *)
+(*                                                                        *)
+(**************************************************************************)
+
+type part =
+  | Merge
+  | Legacy_store
+  | Hooks
+  | Footprint
+  | Projection
+  | Call_starts
+  | Hits_and_starts
+  | Memexec
+  | Walk
+  | Zone_bases
+
+let parts =
+  [ Merge, "merge"; Legacy_store, "legacy store"; Hooks, "hooks";
+    Footprint, "footprint"; Projection, "point projection";
+    Call_starts, "call starts"; Hits_and_starts, "hits and starts";
+    Memexec, "memexec"; Walk, "created and removed walk";
+    Zone_bases, "zone bases" ]
+
+let index = function
+  | Merge -> 0
+  | Legacy_store -> 1
+  | Hooks -> 2
+  | Footprint -> 3
+  | Projection -> 4
+  | Call_starts -> 5
+  | Hits_and_starts -> 6
+  | Memexec -> 7
+  | Walk -> 8
+  | Zone_bases -> 9
+
+let file =
+  match Sys.getenv_opt "HIT_LOG_COST_TIMERS" with
+  | None | Some "" -> None
+  | Some file -> Some file
+
+let on = Option.is_some file
+
+let ablations =
+  match Sys.getenv_opt "HIT_LOG_COST_ABLATE" with
+  | None -> []
+  | Some list -> String.split_on_char ',' list
+
+let ablated name = List.mem name ablations
+
+let no_footprint = ablated "footprint"
+let call_footprint = ablated "footprint-call"
+let no_projection = ablated "projection"
+let no_call_starts = ablated "call-starts"
+let no_hits = ablated "hits"
+let no_legacy = ablated "legacy"
+let no_walk = ablated "walk"
+let no_zone_bases = ablated "zone-bases"
+
+(* Exclusive time of each part: when a part starts within another, the time
+   of the outer part stops until the inner one ends. *)
+let seconds = Array.make (List.length parts) 0.
+let calls = Array.make (List.length parts) 0
+let current = ref (-1)
+let since = ref 0.
+
+let time part f =
+  if not on then f ()
+  else begin
+    let i = index part in
+    let outer = !current in
+    let start = Unix.gettimeofday () in
+    if outer >= 0 then seconds.(outer) <- seconds.(outer) +. (start -. !since);
+    current := i;
+    since := start;
+    calls.(i) <- calls.(i) + 1;
+    let finally () =
+      let stop = Unix.gettimeofday () in
+      seconds.(i) <- seconds.(i) +. (stop -. !since);
+      current := outer;
+      since := stop
+    in
+    Fun.protect ~finally f
+  end
+
+type pass = {
+  name: string;
+  wall: float;
+  cpu: float;
+  gc_before: Gc.stat;
+  gc_after: Gc.stat;
+}
+
+let passes = ref []
+
+let pass name f =
+  if not on then f ()
+  else begin
+    let gc_before = Gc.quick_stat () in
+    let wall = Unix.gettimeofday () and cpu = Sys.time () in
+    let finally () =
+      let gc_after = Gc.quick_stat () in
+      let wall = Unix.gettimeofday () -. wall and cpu = Sys.time () -. cpu in
+      passes := { name; wall; cpu; gc_before; gc_after } :: !passes
+    in
+    Fun.protect ~finally f
+  end
+
+let write file =
+  let out = open_out file in
+  Printf.fprintf out
+    "kind\tname\tcalls\twall\tcpu\tminor_words\tpromoted_words\t\
+     major_words\tminor_collections\tmajor_collections\n";
+  List.iter
+    (fun (part, name) ->
+       let i = index part in
+       Printf.fprintf out "part\t%s\t%d\t%.6f\t\t\t\t\t\t\n"
+         name calls.(i) seconds.(i))
+    parts;
+  List.iter
+    (fun p ->
+       let a = p.gc_after and b = p.gc_before in
+       Printf.fprintf out "pass\t%s\t1\t%.6f\t%.6f\t%.0f\t%.0f\t%.0f\t%d\t%d\n"
+         p.name p.wall p.cpu (a.minor_words -. b.minor_words)
+         (a.promoted_words -. b.promoted_words)
+         (a.major_words -. b.major_words)
+         (a.minor_collections - b.minor_collections)
+         (a.major_collections - b.major_collections))
+    (List.rev !passes);
+  Printf.fprintf out "ablations\t%s\t\t\t\t\t\t\t\t\n"
+    (String.concat "," ablations);
+  close_out out
+
+let () = Option.iter (fun file -> at_exit (fun () -> write file)) file
diff --git a/plugins/eva/src/utils/cost_meter.mli b/plugins/eva/src/utils/cost_meter.mli
new file mode 100644
index 0000000000..0412ed446a
--- /dev/null
+++ b/plugins/eva/src/utils/cost_meter.mli
@@ -0,0 +1,94 @@
+(**************************************************************************)
+(*                                                                        *)
+(*  SPDX-License-Identifier LGPL-2.1                                      *)
+(*  Copyright (C)                                                         *)
+(*  CEA (Commissariat à l'énergie atomique et aux énergies alternatives)  *)
+(*                                                                        *)
+(**************************************************************************)
+
+(** Measurement build of dev/hit-log-cost, never part of the branch: timers of
+    the parts of the iteration and of the passes after it, and ablations that
+    skip one part of the recording of option -eva-hit-log, with wrong answers.
+
+    Both are set by environment variables read once, when the module is
+    initialised:
+    - HIT_LOG_COST_TIMERS: the file where the timers are written at exit;
+      no timer runs if it is unset or empty;
+    - HIT_LOG_COST_ABLATE: a comma-separated list of ablations, among
+      [footprint], [footprint-call], [projection], [call-starts], [hits],
+      [legacy], [walk], [zone-bases]. *)
+
+(** The parts of the iteration timed, exclusive of the parts nested in them. *)
+type part =
+  | Merge
+  (** Merging the states of the statements of a call analysed by its body,
+      for the hooks at the end of the call and the legacy store. *)
+  | Legacy_store
+  (** Registering the states before and after each statement and at the start
+      of each call in the legacy store. *)
+  | Hooks
+  (** The hooks at the end of each call analysed by its body: the inout
+      plugin, which gives the footprint with -eva-hit-log. *)
+  | Footprint
+  (** Evaluating the footprint given by inout at each statement. *)
+  | Projection
+  (** Lifting the states after each statement to cvalue, and projecting the
+      states before and after each statement on the covered blocks. *)
+  | Call_starts
+  (** Keeping the calls made by each body, and projecting their start states
+      on the covered blocks. *)
+  | Hits_and_starts
+  (** Computing the start and body-entry states of the calls, recording the
+      hits and the starts of the calls by specification or builtin with
+      their joins, and storing the cache entries. *)
+  | Memexec
+  (** Matching each call against the memexec cache, and storing the calls
+      analysed by their body in it. *)
+  | Walk
+  (** Within the projections, the walk of the start state of the call and of
+      a state, with [Base.Hptshape.fold2_join_homogeneous], that finds the
+      blocks created by the call, and those removed by a call it makes. *)
+  | Zone_bases
+  (** Within the projections, building the set of the blocks of the
+      footprint at a point. *)
+
+(** [time part f] runs [f], whose time is counted in [part] if the timers
+    run. *)
+val time: part -> (unit -> 'a) -> 'a
+
+(** [pass name f] runs [f], the step [name] after the iteration, whose
+    wall-clock and processor time are counted if the timers run. *)
+val pass: string -> (unit -> 'a) -> 'a
+
+(** Ablations. *)
+
+(** InOut keeps no footprint, and the footprint of every point is empty. *)
+val no_footprint: bool
+
+(** InOut keeps no footprint, and the footprint of every point is the memory
+    read or written by the whole call, its formals and locals included. *)
+val call_footprint: bool
+
+(** The footprint is evaluated at every point, but no state is projected:
+    the Inner parts are empty. *)
+val no_projection: bool
+
+(** The start states of the calls made by each body are not projected. *)
+val no_call_starts: bool
+
+(** The hits and the starts of the calls by specification or builtin are not
+    recorded. *)
+val no_hits: bool
+
+(** The start state of the call and the projected states are not walked: no
+    block is found created by the call, or removed by a call it makes. *)
+val no_walk: bool
+
+(** The set of the blocks of the footprint of each point is not built: the
+    projection keeps the created blocks only. *)
+val no_zone_bases: bool
+
+(** With -eva-hit-log, the states before and after each statement are not
+    registered in the legacy store. The states at the start of the calls still
